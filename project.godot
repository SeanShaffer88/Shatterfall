; Engine configuration file.
; Shatterfall — Godot 4.7.2 stable (D22), Mobile renderer (D2/D39).

config_version=5

[application]

config/name="Shatterfall"
config/version="0.1.0"
config/features=PackedStringArray("4.7", "Mobile")
run/main_scene="res://scenes/main/DungeonRun.tscn"

[autoload]

SaveManager="*res://autoload/SaveManager.gd"
GameState="*res://autoload/GameState.gd"

[display]

window/size/viewport_width=2400
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=true

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="hero"
3d_physics/layer_3="enemy"
3d_physics/layer_4="hero_attack"
3d_physics/layer_5="enemy_attack"

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
